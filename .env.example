# Requires explicit owner indexing approval; only applies to Vercel production.
# Commercial readiness and automatic email have separate approval gates.
SITE_INDEXABLE=false
# Only this canonical production hostname can become indexable.
SITE_URL=https://www.albireno.fr
CONTACT_FORM_ENABLED=false
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Configure privately in Vercel; never commit real credentials.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Comma-separated real hosts permitted by the Turnstile widget.
TURNSTILE_HOSTNAMES=
# Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=
