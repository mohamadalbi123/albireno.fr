# Keep false throughout client preview. Only enable after check:launch passes.
SITE_INDEXABLE=false
# Canonical production address. Approval flags still keep the site noindex.
SITE_URL=https://www.albireno.fr
CONTACT_FORM_ENABLED=false
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Configure privately in Vercel; never commit real credentials.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Comma-separated real hosts permitted by the Turnstile widget.
TURNSTILE_HOSTNAMES=
# Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=
